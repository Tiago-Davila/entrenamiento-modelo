# Configuración de entrenamiento de Eva (lsa64). Lo lee lsa64/entorno.py antes
# de importar Keras. Una variable ya definida en la terminal tiene prioridad.

# Backend de Keras para ENTRENAR.
#   torch       usa la GPU NVIDIA (RTX 5050) con PyTorch CUDA 12.8. Recomendado.
#   tensorflow  solo CPU: TensorFlow no soporta GPU en Windows nativo.
# La exportación a .tflite siempre corre con backend tensorflow en un
# subproceso, cargando los pesos entrenados (ver train_keras_tflite.py).
KERAS_BACKEND=torch

# Silencia los logs informativos de TensorFlow (oneDNN, absl).
TF_CPP_MIN_LOG_LEVEL=2
